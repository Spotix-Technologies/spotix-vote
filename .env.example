# Firebase Admin (voting polls + Reference/payment docs) — same project as spotix-user
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supabase (open-nomination system) — same project as spotix-user
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (caching + rate limiting) — same project as spotix-user
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth (only needed if you want logged-in Spotix users to skip the guest
# form when voting — see README "What's simplified")
ACCESS_TOKEN_SECRET=

# Salt for hashing voter/nominator IPs before storage
IP_HASH_SALT=

# Spotix backend base URL — used to build Dicebear avatar URLs, register
# Paystack customers (v1/customer/upsert), and reconcile payments on the
# poll callback page (v1/verify-payment)
NEXT_PUBLIC_BACKEND_URL=

# Paystack — same public key spotix-user's checkout uses. Safe to expose
# client-side (it's the PUBLIC key); the secret key lives only in
# spotix-backend.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
